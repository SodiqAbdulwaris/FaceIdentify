# openapi-typescript (the API type generator, plan decision 5) declares a peer range of
# typescript ^5.x; the app is on TypeScript 6 and the generator works with it (its output is
# type-checked in CI). Without this, `npm install` refuses the tree with ERESOLVE. Remove it when
# openapi-typescript's range includes TypeScript 6.
legacy-peer-deps=true
